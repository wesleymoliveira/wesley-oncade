     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Last full check",
   "description": "The check that catches lost webhooks and stuck batches. Page above 30 s here.",
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - max(reconcile_last_success_seconds)",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
