  {
   "id": 23,
   "type": "table",
   "title": "Traces of this run",
   "gridPos": {
    "x": 0,
    "y": 36,
    "w": 24,
    "h": 7
   },
   "datasource": {
    "type": "tempo",
    "uid": "tempo"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "tempo",
      "uid": "tempo"
     },
     "queryType": "traceql",
     "query": "{ span.run.reference = \"$reference\" }",
