  {
   "id": 8,
   "type": "row",
   "title": "The run, step by step",
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,
    "h": 1
   },
   "collapsed": false
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Runs by new state",
   "description": "created \u2192 awaiting_funds \u2192 funded \u2192 processing \u2192 completed",
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (to) (increase(runs_transitions_total[1m]))",
     "legendFormat": "{{to}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Batches by new state",
