   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 7,
   "type": "stat",
   "title": "Oldest unpaid invoice",
   "description": "Not an incident by itself: the client has not paid yet.",
