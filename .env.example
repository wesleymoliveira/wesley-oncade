# Only the Oncade test API needs this file. With no .env, or with this one
# copied as it is, everything runs against the local stand-in.

# --- The Oncade test API ------------------------------------------------------
# A platform TEST key (oncade_platform_test_...). A live key is refused.
API_KEY=
# The platform webhook secret, from the developer portal.
ONCADE_WEBHOOK_SECRET=

# --- Our own API --------------------------------------------------------------
# Guards every route except the signed webhook and health. The stand-in has
# its own; with Oncade it must be set:
#   openssl rand -hex 32
APP_TOKEN=
# Where our own customer is told about a run, and the secret that signs it.
# Unset: nobody is told.
# CUSTOMER_WEBHOOK_URL=
# CUSTOMER_WEBHOOK_SECRET=

# --- Addresses you read, for the runs against the Oncade test API -------------
# Oncade may send real e-mail to them. The team list takes one to three
# addresses, separated by commas. With fewer than three, the missing people
# become "+payee1" aliases of an address already given.
DEMO_CLIENT_EMAIL=
DEMO_TEAM_EMAILS=
