{
  "name": "payout-runs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unofficial exercise: a payout run on the Oncade Platform API (test mode).",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev -p 3300 -H 127.0.0.1",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start -p 3300 -H 127.0.0.1",
    "start:oncade": "PROVIDER=oncade NEXT_TELEMETRY_DISABLED=1 next start -p 3300 -H 127.0.0.1",
    "worker": "node --env-file-if-exists=.env worker/main.ts",
    "worker:oncade": "PROVIDER=oncade node --env-file-if-exists=.env worker/main.ts",
    "stand-in": "node stand-in/server.ts",
    "demo": "node --env-file-if-exists=.env scripts/demo.ts",
    "where": "node --env-file-if-exists=.env scripts/where.ts",
    "where:oncade": "PROVIDER=oncade node --env-file-if-exists=.env scripts/where.ts",
    "check-api": "node --env-file-if-exists=.env scripts/check-api.ts",
    "explore": "node --env-file-if-exists=.env explore/run.ts",
    "explore:coverage": "node explore/coverage.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:flows": "vitest run -c vitest.flows.config.ts",
    "drill": "node --env-file-if-exists=.env scripts/drill.ts",
    "operator": "node --env-file-if-exists=.env scripts/operator.ts",
    "operator:oncade": "PROVIDER=oncade node --env-file-if-exists=.env scripts/operator.ts",
    "context:budget": "node scripts/context-budget.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run context:budget",
    "fixtures": "node scripts/record-fixtures.ts",
    "real-run": "node --env-file-if-exists=.env scripts/real-run.ts",
    "real-run:oncade": "PROVIDER=oncade node --env-file-if-exists=.env scripts/real-run.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.10.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1169.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "mongodb": "^7.9.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
